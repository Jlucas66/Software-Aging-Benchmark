// Configuracao geral do benchmark.
// Linhas que comecam com // sao comentarios (o programa ignora).
// Use barras normais (/) nos caminhos. Caminho sem "C:/" no comeco e contado a partir
// da pasta do repositorio (ex.: "UE5Benchmark" = C:/Pesquisa/Software-Aging-Benchmark/UE5Benchmark).
{
  "unreal": {
    // Pasta onde a Unreal Engine 5.4 foi instalada pelo Epic Games Launcher
    "engine_dir": "C:/Program Files/Epic Games/UE_5.4",
    // Projeto UE5-Benchmark (onde fica o Benchmark.uproject), dentro do repositorio
    "project_dir": "UE5Benchmark",
    // Onde o jogo empacotado (.exe) e gerado. Fica FORA do repositorio (sao varios GB)
    "package_dir": "C:/UE5BenchmarkBuild",
    // Ray tracing por hardware (ja ligado no DefaultEngine.ini do projeto); so registrado no sessao.json
    "enable_hardware_ray_tracing": true
  },

  "game": {
    // Vazio = detecta sozinho dentro de package_dir
    "exe": "",
    // Use a resolucao nativa do monitor (ex.: [2560, 1080] em casa)
    "resolution": [2560, 1080],
    // "fullscreen" ou "windowed"
    "window_mode": "fullscreen",
    // Frame Generation exige DirectX 12
    "rhi": "dx12",
    // null = usa a velocidade definida no nivel; numero = cm/s
    "camera_speed": null,
    "extra_args": ["-unattended", "-nosplash", "-NoVerifyGC"]
  },

  "run": {
    // Duracao padrao de cada teste (pode ser trocada na hora com --hours ou --minutes)
    "default_hours": 48,
    // Intervalo entre amostras, em segundos
    "sample_interval_s": 5,
    // Pausa entre testes para a GPU esfriar (deixa os testes comparaveis)
    "cooldown_minutes": 10,
    // Quantas vezes reabrir o jogo se ele fechar sozinho no meio de um teste
    "max_restarts": 20,
    // true = aborta o teste se algum cvar de DLSS nao ficar com o valor pedido
    "strict_cvar_check": true,
    // Quanto esperar o jogo abrir (a primeira abertura compila shaders)
    "startup_timeout_s": 600,
    // Pasta dos resultados, dentro do repositorio
    "output_dir": "BenchmarkRuns"
  },

  // So usado no Linux: o mesmo jogo empacotado no Windows, aberto pelo Proton
  "linux": {
    // Pasta do jogo copiada do Windows (a C:/UE5BenchmarkBuild inteira)
    "package_dir": "~/UE5BenchmarkBuild",
    // Lancador do Proton fora da Steam (umu-launcher). Caminho do umu-run extraido do
    // arquivo "zipapp" (Zorin/Ubuntu); se instalou pelo gerenciador de pacotes, use so "umu-run"
    "launcher": "~/.local/share/umu/umu-run",
    // Pasta do Proton usado. Versao FIXA durante toda a pesquisa (anote no trabalho).
    // Se usar outra versao, troque pelo nome da pasta que voce extraiu.
    "proton_path": "~/.local/share/Steam/compatibilitytools.d/GE-Proton11-11",
    // Prefixo do Wine so do benchmark (criado sozinho na primeira execucao)
    "wine_prefix": "~/.local/share/bench-prefix",
    "env": {
      // Mostra a NVAPI ao jogo: sem isso o DLSS nao aparece
      "PROTON_ENABLE_NVAPI": "1",
      // Nao deixa o Proton baixar versoes novas do DLSS (o mesmo que o OTA desligado)
      "PROTON_ENABLE_NGX_UPDATER": "0"
    }
  },

  "monitor": {
    "gpu_index": 0,
    // Registro dos OUTROS processos (arquivo <teste>_processos.csv): a cada N segundos,
    // os que usaram pelo menos X% da CPU ou Y MB de memoria
    "processos_intervalo_s": 60,
    "processos_cpu_min_pct": 1,
    "processos_mem_min_mb": 300,
    // Seu proprio script de monitoramento, se quiser rodar junto. {out_dir} vira a pasta da sessao.
    // Exemplo: ["python", "C:/scripts/meu_monitor.py", "--output", "{out_dir}/meu_monitor.csv"]
    "external_cmd": null
  },

  "report": {
    // Minutos iniciais fora das medias do relatorio (aquecimento, compilacao de shaders).
    // O Mann-Kendall tem a sua propria opcao (--aquecimento, padrao 30 min).
    "warmup_minutes": 5
  }
}